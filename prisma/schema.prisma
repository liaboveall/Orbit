// Orbit · Prisma 7 schema（M0 基线）
//
// Prisma 7 约定（区别于 6/8）：
//   - datasource 只声明 provider；连接串 url 在根目录 prisma.config.ts 配置。
//   - generator 使用新的 "prisma-client"（Rust-free），且 output 为必填，
//     客户端不再默认生成到 node_modules。
//
// M0 范围：仅支撑「空数据库可连接 + 迁移工具链可用」。
// M1（ORB-004）：引入 Better Auth 1.7.3 认证模型（User/Session/Account/Verification）。
// 认证表字段严格对齐 @better-auth/core@1.7.3 dist/db/schema/*（官方生成结果，不擅自删改）；
// User.timezone 是 Orbit 业务扩展字段（docs/04 §3），由本项目添加。
// 其余业务表（Project/Task 等）随 M2 起按 docs/04 引入。

datasource db {
  provider = "postgresql"
}

model RateLimitBucket {
  keyHash String @id @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  count Int
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

model UploadLease {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyHash String @db.Char(64)
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  active Boolean @default(true)
  @@index([keyHash, startedAt])
  @@index([expiresAt])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ── Better Auth 认证模型（1.7.3 官方 schema）───────────────────────────────
// id 使用认证库默认 cuid()（字符串，非 UUID）；业务 userId 与之同类型（docs/04 §1）。
// email/token 唯一约束、userId 外键 Cascade、@updatedAt、userId/identifier 索引均为库要求，不删改。

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  emailVerified       Boolean             @default(false)
  image               String?
  // Orbit 业务扩展字段：IANA 时区（docs/04 §3）。默认 Asia/Shanghai。
  timezone            String              @default("Asia/Shanghai")
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  accounts            Account[]
  // M2 项目域反向关系（docs/04）：owner 的项目、成员关系、活动、幂等记录。
  ownedProjects       Project[]           @relation("ProjectOwner")
  memberships         ProjectMember[]     @relation("ProjectMembership")
  activities          ActivityLog[]       @relation("ActivityActor")
  idempotencyKeys     IdempotencyRecord[] @relation("IdempotencyUser")
  // M4 邀请关系
  invitationsCreated  Invitation[]        @relation("InvitationCreator")
  invitedToProjects   Invitation[]        @relation("InvitationAcceptedBy")
  // M2 任务域反向关系（docs/04 §3）：创建的任务、被分配的任务。
  createdTasks        Task[]              @relation("TaskCreator")
  assignedTasks       Task[]              @relation("TaskAssignee")
  // M5 评论与附件关系
  comments            Comment[]           @relation("CommentAuthor")
  uploadedAttachments Attachment[]        @relation("AttachmentUploader")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  // 邮箱密码认证的密码哈希仅由认证库存于此列（credential provider），业务 API 永不返回。
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// ── M2 项目域枚举 ──────────────────────────────────────────────
// 取值严格对齐 src/contracts/enums.ts（PROJECT_COLOR / ACTIVITY_ENTITY_TYPE / ACTIVITY_ACTION）。
// PROJECT_ROLE 不入数据库（计算得出，docs/05 §4）。

enum ProjectColor {
  BLUE
  PURPLE
  TEAL
  GREEN
  ORANGE
  GRAY
}

enum ActivityEntityType {
  PROJECT
  MEMBER
  TASK
  SUBTASK
  COMMENT
  ATTACHMENT
}

enum ActivityAction {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_DELETED
  TASK_RESTORED
  SUBTASK_CREATED
  SUBTASK_UPDATED
  SUBTASK_DELETED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  FILE_UPLOADED
  FILE_DELETED
}

// ── M2 项目域模型（docs/04 §3）────────────────────────────────────────
// 业务实体 id 用 @db.Uuid + gen_random_uuid()；FK 到 User.id 的字段用 String（TEXT/cuid）。
// 所有 onDelete: Restrict：用户/项目存在引用时不允许级联删除（保护业务数据）。
// CHECK 约束（key 格式、计数器正值、bytes 非负）无法由 Prisma schema 表达，在迁移 SQL 中手写。

model Project {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String
  name           String       @db.VarChar(80)
  key            String       @unique @db.VarChar(8)
  description    String       @default("")
  color          ProjectColor
  archivedAt     DateTime? @db.Timestamptz(3)
  version        Int          @default(1)
  boardVersion   Int          @default(1)
  nextTaskNumber Int          @default(1)
  reservedBytes  BigInt       @default(0)
  usedBytes      BigInt       @default(0)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  invitations Invitation[]
  activities  ActivityLog[]
  tasks       Task[]
  attachments Attachment[]

  @@index([ownerId, archivedAt, updatedAt, id])
  
  // A-02: CHECK 约束已在 prisma/migrations/20260911033000_add_project_quota_checks/migration.sql 中添加
  // @@checkConstraint("non_negative_reserved", "reservedBytes >= 0")
  // @@checkConstraint("non_negative_used", "usedBytes >= 0")
}

model ProjectMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  userId    String
  joinedAt  DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation("ProjectMembership", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId, projectId])
}

// ── M4 邀请模型（docs/04 §5）────────────────────────────────────────
// token 为 32 随机字节的 URL 安全编码；数据库仅存 SHA-256 摘要 (char(64))。
// INVITE_TOKEN 明文仅在创建响应返回一次，不进入日志或持久层。
// acceptedAt 与 acceptedById 同时为空或同时非空（原子性）。

model Invitation {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String    @db.Uuid
  createdById  String
  tokenHash    String    @unique @db.Char(64)
  expiresAt    DateTime @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  acceptedAt   DateTime? @db.Timestamptz(3) // Must be NULL if acceptedById is NULL, and vice versa (docs/04 §5)
  acceptedById String? // Both must be NULL or both non-NULL - enforced by DB CHECK constraint
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator    User    @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  // Business rule for database integrity - enforced via trigger in migration
  // acceptedAt and acceptedById must be both NULL or both non-NULL

  @@index([projectId, createdAt, id])
  @@index([expiresAt])
}

model ActivityLog {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String             @db.Uuid
  actorId    String
  entityType ActivityEntityType
  entityId   String
  action     ActivityAction
  metadata   Json               @default("{}")
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor   User    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
}

model IdempotencyRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  method         String   @db.VarChar(10)
  routeKey       String
  key            String   @db.VarChar(128)
  requestHash    String   @db.Char(64)
  responseStatus Int
  responseBody   Json
  resourceId     String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  user User @relation("IdempotencyUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, method, routeKey, key])
  @@index([expiresAt])
  // F17：评论删除等按 resourceId 反查幂等缓存的热路径更新（docs/04 §3）。
  @@index([resourceId])
}

// ── M2 任务域枚举（docs/04 §3）────────────────────────────────
// 取值严格对齐 src/contracts/enums.ts（TASK_STATUS / TASK_PRIORITY）。
// TaskPriority 声明顺序 NONE→LOW→MEDIUM→HIGH：PostgreSQL 枚举按声明序排序，
// 故 `ORDER BY priority DESC` 恰好得到 HIGH→MEDIUM→LOW→NONE（docs/05 §6）。

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
}

// ── M2 任务域模型（docs/04 §3）────────────────────────────────
// id 用 @db.Uuid + gen_random_uuid()；FK 到 User.id 的字段用 String（TEXT/cuid）。
// creatorId onDelete Restrict（保护历史）；assigneeId onDelete SetNull（成员退出/删除时置空）。
// position 为 bigint，仅服务端处理，永不入 DTO（docs/04 §5）。
// CHECK 约束（number>0、version>0、title trim 非空、DONE⇔completedAt）无法由 Prisma 表达，在迁移 SQL 手写。

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String       @db.Uuid
  number      Int
  creatorId   String
  assigneeId  String?
  title       String       @db.VarChar(120)
  description String       @default("")
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NONE)
  dueDate     DateTime?    @db.Date
  position    BigInt
  completedAt DateTime? @db.Timestamptz(3)
  version     Int          @default(1)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  project  Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator  User    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  moveRecords MoveRecord[]
  subtasks    Subtask[]
  comments    Comment[]
  attachments Attachment[]

  @@unique([projectId, number])
  @@unique([id, projectId])
  @@index([projectId, deletedAt, status, position, id])
  @@index([projectId, deletedAt, updatedAt, id])
  @@index([assigneeId, deletedAt, status, dueDate, id])
}

model MoveRecord {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String   @db.Uuid
  fromStatus   String
  toStatus     String
  fromPosition BigInt
  toPosition   BigInt
  boardVersion Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt(sort: Desc)])
}

// ── M5 子任务域模型（docs/04 §3）───────────────────────────────────────
// Subtask 跟随 Task 生命周期；onDelete: Restrict（硬删除被存在子任务的任务所阻止，
// 防误删；应用层软删除不触发本约束）。
// version 用于并发冲突检测；deletedAt 支持软删除；显示顺序为 createdAt, id。

model Subtask {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String    @db.Uuid
  title       String    @db.VarChar(200)
  isCompleted Boolean   @default(false)
  version     Int       @default(1)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, id])
  @@index([taskId, deletedAt, createdAt, id])
}

// ── M5 评论域模型（docs/04 §3）──────────────────────────────────────────
// Comment 归属 Task，作者为 authorId；编辑不删原文但记录 editedAt。
// deletedAt 时清空 body（保留 authorId 与时间戳供审计）；版本控制见 ORB-017。

model Comment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String    @db.Uuid
  authorId  String
  body      String    @db.Text
  version   Int       @default(1)
  editedAt  DateTime? @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([taskId, id])
  @@index([taskId, createdAt, id])
}

// ── M5 附件域模型（docs/04 §6）──────────────────────────────────────────
// Attachment 通过 (taskId, projectId) 复合 FK 防止跨项目关联；state 为 UPLOADING/READY/FAILED/DELETED。
// declaredSizeBytes 为上传预算预留；sizeBytes/sha256 在完成时填充；cleanupPending 标记孤儿清理待处理。
// UNIQUE(taskId, uploaderId, clientUploadId) 防重试重复；CHECK constraints 在迁移 SQL 中定义。

model Attachment {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String          @db.Uuid
  taskId            String          @db.Uuid
  uploaderId        String
  clientUploadId    String          @db.Uuid
  claimedSha256     String          @db.Char(64) // Client-declared hash, stored as hex
  originalName      String          @db.VarChar(255)
  objectKey         String          @unique @db.Text
  mimeType          String
  declaredSizeBytes BigInt
  sizeBytes         BigInt?
  sha256            String?         @db.Char(64)
  state             AttachmentState
  cleanupPending    Boolean         @default(false)
  errorCode         String?
  deletedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  project  Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task     Task    @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict, map: "Attachment_taskId_projectId_fkey")
  uploader User    @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@unique([taskId, id])
  @@unique([taskId, uploaderId, clientUploadId])
  @@index([taskId, state, createdAt, id])
  @@index([state, cleanupPending, updatedAt])
}

enum AttachmentState {
  UPLOADING
  READY
  FAILED
  DELETED
}
