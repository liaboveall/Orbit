# 文档样例。M0/M1按实际配置补全；不得用于生产。
APP_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://orbit:orbit_dev_only@localhost:5432/orbit_dev
# Pool default 5; tune only after measuring the target deployment (1–20).
DATABASE_POOL_MAX=5
# Set this to the fingerprint printed by a reviewed maintenance preview before --execute.
ORBIT_MAINTENANCE_TARGET=
TEST_DATABASE_URL=postgresql://orbit:orbit_dev_only@localhost:5432/orbit_test
BETTER_AUTH_URL=http://localhost:3000
# 安全随机生成本地值，不提交实际.env.local
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:3000
SMTP_HOST=localhost
# Mailpit SMTP：宿主 25025 → 容器 1025（compose.dev.yml 映射）。不用宿主 1025：
# Windows 临时端口区间（1024–15000）会随机占用 1025 导致 bind 失败。
SMTP_PORT=25025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Orbit <no-reply@orbit.local>"
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=orbit-dev
STORAGE_ACCESS_KEY_ID=orbit_dev_access
STORAGE_SECRET_ACCESS_KEY=orbit_dev_secret_change
STORAGE_FORCE_PATH_STYLE=true
LOG_LEVEL=debug
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_DAILY_REQUEST_LIMIT=10
# 本机前方受信任反向代理跳数，默认 0（不信任 X-Forwarded-For，直连场景安全默认值）。
# 仅在确认部署拓扑中存在固定层数的受信代理时调大，取值为该链路上受信代理数量。
TRUSTED_PROXY_COUNT=0
# E2E 专用应用端口（scripts/e2e-server.mjs / playwright.config.ts），与开发服务器
# 默认的 3000 分开；一般不需要修改，仅当 3100 在本机被占用时才覆盖。
E2E_PORT=3100
