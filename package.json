{
  "name": "orbit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Orbit — 面向个人与学生小团队的项目协作 Web App。",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "pretest:e2e": "node scripts/verify-e2e-target.mjs",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:contract": "vitest run --project contract",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:contract",
    "cleanup:attachments": "node --conditions=react-server --import tsx scripts/cleanup-attachments.ts",
    "maintenance:cleanup": "node --conditions=react-server --import tsx scripts/maintenance-cleanup.ts",
    "cleanup:idempotency": "node --conditions=react-server --import tsx scripts/cleanup-idempotency.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1130.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "better-auth": "1.7.3",
    "busboy": "1.6.0",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.8",
    "nodemailer": "10.0.16",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/busboy": "1.5.4",
    "@types/node": "26.6.2",
    "@types/pg": "8.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "dotenv": "17.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "mysql2@3.15.3": "3.23.1",
      "@prisma/config@7.10.0>deepmerge-ts": "8.0.0",
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@<1.2.2": "1.2.2",
      "fast-uri@<3.1.8": "3.1.8",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12"
    }
  }
}
